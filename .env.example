ANIVORA_SECURITY_APP_NAME=AniVora Security
ANIVORA_SECURITY_VERSION=0.1.0

ANIVORA_SECURITY_HOST=0.0.0.0
ANIVORA_SECURITY_PORT=8010

# IMPORTANT:
# Generate a real random value for production.
# Never commit the real secret to GitHub.
ANIVORA_SECRET_KEY=replace-this-with-a-random-secret-at-least-32-characters-long

ANIVORA_JWT_ALGORITHM=HS256
ANIVORA_JWT_ISSUER=anivora
ANIVORA_JWT_AUDIENCE=anivora-api
ANIVORA_JWT_EXPIRE_MINUTES=30

ANIVORA_RATE_LIMIT_REQUESTS=60
ANIVORA_RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated browser origins.
ANIVORA_ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated trusted hosts.
ANIVORA_ALLOWED_HOSTS=localhost,127.0.0.1
